---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lanes, laneOf, beliefsFrom } from '../../data/home.ts';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { project: p.data.slug }, props: { project: p } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const p = project.data;
const company = await getEntry(p.company);
const { Content } = await render(project);

/* Same order as the home page lanes, wrapping, so every page has a previous
   and a next. */
const order = lanes.flatMap((l) => [...l.items.map((i) => i.slug), ...(l.earlier ?? []).map((e) => e.slug)]);
const all = await getCollection('projects');
const bySlug = new Map(all.map((x) => [x.data.slug, x.data]));
const i = order.indexOf(p.slug);
const prev = bySlug.get(order[(i - 1 + order.length) % order.length])!;
const next = bySlug.get(order[(i + 1) % order.length])!;

const lane = laneOf(p.slug);
const taught = beliefsFrom(p.slug);

const yr = (d: Date) => d.getFullYear();
const when = !p.end ? `${yr(p.start)} to now` : yr(p.end) === yr(p.start) ? `${yr(p.start)}` : `${yr(p.start)} to ${yr(p.end)}`;
---

<BaseLayout title={`${p.name}, Sanket Shah`} description={p.tagline}>
  <div class="swipeback" aria-hidden="true">&larr; All work</div>

  <article class="wrap case" data-case>
    <a class="backlink" href="/#work">&larr; All work</a>
    <p class="sec-head__label case__kicker">
      {lane ? lane.title : 'Work'}
    </p>
    <h1 class="case__h1">{p.name}</h1>
    <p class="case__tag">
      {p.tagline.split(' ').slice(0, -1).join(' ')}{' '}<span style="white-space: nowrap">{p.tagline.split(' ').at(-1)}<a class="cite" href="#anatomy" aria-label="Sources for this project">[1]</a></span>
    </p>

    <div class="case__grid">
      <div>
        <div class="prose"><Content /></div>

        {
          taught.length > 0 && (
            <section class="learned" aria-labelledby="learned-h">
              <h2 class="kicker" id="learned-h">What this taught me</h2>
              {taught.map((b) => (
                <figure class="learned__q">
                  <blockquote>&ldquo;{b.quote}&rdquo;</blockquote>
                </figure>
              ))}
              <a class="more" href="/#beliefs">Everything I believe now <span aria-hidden="true">&rarr;</span></a>
            </section>
          )
        }
      </div>

      <aside class="anatomy" id="anatomy" aria-label="Sources">
        <div class="anatomy__bar">
          <span>[1] anatomy</span>
          <span class:list={[p.live && 'tone-amber']}>{p.live ? '● live' : '○ not live'}</span>
        </div>
        <dl>
          <div><span class="ref" aria-hidden="true">a</span><dt>Where</dt><dd>{company?.data.name}, {company?.data.role.toLowerCase()}</dd></div>
          <div><span class="ref" aria-hidden="true">b</span><dt>When</dt><dd>{when}</dd></div>
          <div>
            <span class="ref" aria-hidden="true">c</span><dt>Built with</dt>
            <dd><ul class="stack-list">{p.stack.map((s) => <li>{s}</li>)}</ul></dd>
          </div>
          <div><span class="ref" aria-hidden="true">d</span><dt>Status</dt><dd class:list={[p.live && 'live']}>{p.status}</dd></div>
        </dl>
      </aside>
    </div>
  </article>

  <nav class="wrap case-nav" aria-labelledby="more-h">
    <h2 class="sec-head__label case-nav__h" id="more-h">More work</h2>
    <ul class="case-nav__grid">
      {
        [
          ['prev', 'Previous', prev],
          ['next', 'Next', next],
        ].map(([dir, label, x]: any) => (
          <li>
            <article class="card">
              <p class="card__status">{dir === 'prev' ? '←' : '→'} {label}</p>
              <h3 class="card__name"><a href={`/work/${x.slug}`} data-dir={dir}>{x.name}</a></h3>
              <p class="card__line">{x.tagline}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>
