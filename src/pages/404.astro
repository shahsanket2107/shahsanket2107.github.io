---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found, Sanket Shah" description="That page does not exist.">
  <section class="wrap section">
    <header class="sec-head railed">
      <p class="sec-head__label">404</p>
      <div>
        <h1 class="sec-head__title">This one did not ship</h1>
        <p class="sec-head__dek">
          That address does not point at anything. Everything that does is filed under the work.
        </p>
      </div>
    </header>
    <p class="hero__cta">
      <a class="link" href="/">Home</a>
      <a class="link" href="/#work">See the work</a>
    </p>
  </section>
</BaseLayout>
