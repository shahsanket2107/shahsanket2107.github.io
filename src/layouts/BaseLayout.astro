---
import '../styles/global.css';
import { resumeHref } from '../data/profile.ts';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Sanket Shah is a software engineer in Houston. He builds trading systems, quant research tooling on Chinese commodity futures, and the tooling that makes AI agents cite their sources.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav: [string, string][] = [
  ['/#work', 'Work'],
  ['/#about', 'About'],
  ['/#contact', 'Contact'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0d0b" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="author" content="Sanket Shah" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="preload" href="/fonts/instrumentserif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    {/* Interactive bits hide their extra panels only once JS is here, so a
        reader without it still sees every panel, note and source. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__in">
        <a class="wordmark" href="/">Sanket Shah<i aria-hidden="true"></i></a>
        <nav class="nav" aria-label="Main">
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <a class="resume" href={resumeHref}>Resume</a>
      </div>
    </header>

    <nav class="navstrip" aria-label="Sections">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap site-footer__in">
        <p>&copy; {new Date().getFullYear()} Sanket Shah &middot; Houston, Texas</p>
        <p class="site-footer__links">
          <a href="mailto:sanket.masters@gmail.com">Email</a>
          <a href="https://github.com/shahsanket2107">GitHub</a>
          <a href="https://linkedin.com/in/sanketshah2107">LinkedIn</a>
        </p>
      </div>
    </footer>

    <script src="../scripts/site.js"></script>
  </body>
</html>
